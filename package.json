{
  "name": "@formatforge/json-tools",
  "version": "0.8.0",
  "description": "Fast, lightweight TypeScript utilities for JSON formatting, validation, transformation, comparison, patching, pointers, JSONPath queries, and JSON Schema.",
  "keywords": [
    "json",
    "typescript",
    "javascript",
    "formatter",
    "validator",
    "flatten",
    "unflatten",
    "browser",
    "nodejs",
    "formatforge",
    "diff",
    "compare",
    "json-patch",
    "rfc-6902",
    "json-pointer",
    "jsonpath",
    "json-schema",
    "draft-2020-12"
  ],
  "license": "MIT",
  "author": "Gajendra Paliwal",
  "homepage": "https://formatforge.in/tools/json-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/gajendra-paliwal/formatforge-json-tools.git"
  },
  "bugs": {
    "url": "https://github.com/gajendra-paliwal/formatforge-json-tools/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
